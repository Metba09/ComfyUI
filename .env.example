# Copie ce fichier en `.env` (make setup le fait pour toi). Aucun secret : ne rien y mettre de confidentiel.
# Chargé par scripts/sandbox/*.sh ; ComfyUI lui-même ne lit pas ce fichier.

# --- Serveur local (smoke test et usage manuel) ---
COMFY_HOST=127.0.0.1
COMFY_PORT=8188
# Options passées à main.py par `make run` : CPU seulement (pas de GPU dans le sandbox),
# --offline = pas de nœuds partenaires + politique CSP qui bloque le frontend hors machine.
COMFY_ARGS="--cpu --offline --disable-auto-launch"

# --- Aucune sortie vers Internet (valeurs par défaut des scripts, rappelées ici) ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1

# --- Environnement Python ---
# Emplacement du venv (par défaut : .venv à la racine du dépôt).
# COMFY_VENV=/chemin/vers/venv

# --- Clé des nœuds partenaires : laissée VIDE volontairement (ces nœuds sont désactivés par --offline) ---
# COMFY_API_KEY=
